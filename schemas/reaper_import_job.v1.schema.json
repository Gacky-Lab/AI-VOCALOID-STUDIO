{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REAPER WAV import preparation job (local, not a REAPER API)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_version",
    "tracks"
  ],
  "properties": {
    "job_version": {
      "const": "1.0.0"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source_path",
          "position_seconds"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "position_seconds": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
