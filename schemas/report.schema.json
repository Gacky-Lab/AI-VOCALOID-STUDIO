{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "song_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
    },
    "status": {
      "enum": [
        "NEW",
        "INGESTED",
        "ALIGNED",
        "SCORE_READY",
        "VOCAL_RENDERED",
        "MIXED",
        "QC_PASSED",
        "APPROVED",
        "NEEDS_REVIEW",
        "WAITING_MANUAL",
        "FAILED"
      ]
    },
    "requested_mode": {
      "enum": [
        "original",
        "hybrid",
        "remix",
        "rebuild"
      ]
    },
    "actual_mode": {
      "enum": [
        "original",
        "hybrid",
        "remix",
        "rebuild"
      ]
    },
    "voice_id": {
      "const": "hatsune_miku_v6"
    },
    "renderer": {
      "enum": [
        "v6_mcp",
        "v6_manual",
        "v7_manual",
        "not_rendered"
      ]
    },
    "auto_completed": {
      "type": "boolean"
    },
    "manual_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q(0[1-9]|10)$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "measurements": {
            "type": "object"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
            },
            "minItems": 0
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "auto_status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "measurements",
          "evidence",
          "reason",
          "auto_status"
        ],
        "additionalProperties": false
      },
      "minItems": 10,
      "maxItems": 10
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "rights_status": {
      "enum": [
        "pending_review",
        "confirmed",
        "denied"
      ]
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "master_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "reviewer",
            "at",
            "master_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "song_id",
    "run_id",
    "status",
    "requested_mode",
    "actual_mode",
    "voice_id",
    "renderer",
    "auto_completed",
    "manual_actions",
    "checks",
    "artifacts",
    "rights_status",
    "approval"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPROVED"
          }
        }
      },
      "then": {
        "properties": {
          "rights_status": {
            "const": "confirmed"
          },
          "approval": {
            "type": "object"
          },
          "renderer": {
            "not": {
              "const": "not_rendered"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "auto_completed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "manual_actions": {
            "maxItems": 0
          },
          "renderer": {
            "const": "v6_mcp"
          },
          "status": {
            "enum": [
              "QC_PASSED",
              "APPROVED",
              "NEEDS_REVIEW"
            ]
          }
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "Q01"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "Q02"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "Q03"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "Q04"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "Q05"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "Q06"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "Q07"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "Q08"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "Q09"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "checks": {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "Q10"
              }
            },
            "required": [
              "id"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPROVED"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      }
    }
  ]
}
